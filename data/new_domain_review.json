  ],
  "disability_functioning": [
   "障害・生活機能",
   "障害、活動制限、日常生活動作（ADL・IADL）、Washington Group の設問などの生活機能。要介護認定や介護保険サービスの利用とは区別する"
  ],
  "time_use_leisure": [
   "生活時間・余暇",
   "生活時間の配分、余暇活動、趣味、ボランティアなどの社会参加。身体活動の量やソーシャルキャピタルとは区別する"
  ],
  "economy_industry": [
   "経済・産業",
   "農業生産、観光、産業連関、消費支出、技術普及など、健康以外の経済・産業指標そのもの。個人の所得・貧困とは区別する"
  ]
 },
