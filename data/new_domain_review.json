  "environmental_exposure": [
   "気象・環境曝露",
   "気温・湿度・日照・季節などの気象条件、大気汚染（PM2.5など）、放射性物質、標高、化学物質など、環境からの曝露。居住環境や地域の社会経済的特徴とは区別する"
  ],
  "climate_carbon": [
   "環境負荷・脱炭素",
